---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Devices from '../components/Devices.astro';
import Screens from '../components/Screens.astro';
import SupportStrip from '../components/SupportStrip.astro';
import { t, pageUrl, asset, type Lang } from '../i18n';
import { getRelease } from '../lib/release';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (en: string) => t(lang, en);
const description = T('Free, open-source indoor cycling app for your smart trainer. Ride GPX routes in 3D or along ride videos, alone or with friends. No subscription, no account.');
const release = await getRelease();
const home = new URL(pageUrl('en', 'home'), Astro.site).href;
const logo = new URL(asset('logo.png'), Astro.site).href;
// Tells search engines what ORQWA is: a free app, its platforms and where to get it. The
// WebSite names the site, else Google shows "GitHub" for orqwa.github.io; the black-orca
// logo on white is the thumbnail it should pick.
const app = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'ORQWA', url: home },
    { '@type': 'WebPage', url: new URL(pageUrl(lang, 'home'), Astro.site).href, primaryImageOfPage: logo },
    {
      '@type': 'SoftwareApplication',
      name: 'ORQWA',
      description,
      url: new URL(pageUrl(lang, 'home'), Astro.site).href,
      downloadUrl: new URL(pageUrl(lang, 'download'), Astro.site).href,
      image: [logo, new URL(asset('og.jpg'), Astro.site).href],
      applicationCategory: 'SportsApplication',
      operatingSystem: 'macOS, Windows, Linux, Android',
      softwareVersion: release.version,
      inLanguage: ['en', 'de'],
      license: 'https://github.com/ORQWA/ORQWA/blob/main/LICENSE',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CHF' },
    },
  ],
};
---
<Base lang={lang} page="home" title={`ORQWA – ${T('Free indoor cycling app for your smart trainer')}`} {description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(app)} />
  <Hero slot="hero" lang={lang} />
  <Features lang={lang} />
  <Devices lang={lang} />
  <Screens lang={lang} />
  <section class="next-steps" aria-labelledby="next-h">
    <div class="wrap">
      <div class="sec-head"><h2 id="next-h">{T('Get Started')}</h2></div>
      <div class="next">
        <a class="feat next-item" href={pageUrl(lang, 'how')}>
          <svg class="next-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.01"/></svg>
          <span class="next-text">
            <span class="next-title">{T('Under the Hood')}</span>
            <span class="next-line">{T('How your data is handled and when the internet is used.')}</span>
          </span>
          <span class="next-go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6"/></svg></span>
        </a>
        <a class="feat next-item" href="https://github.com/ORQWA/ORQWA/wiki" target="_blank" rel="noopener">
          <svg class="next-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5M8 7.5h8M8 11h6"/></svg>
          <span class="next-text">
            <span class="next-title">{T('User Guide')}</span>
            <span class="next-line">{T('Detailed instructions for setting up and using the app.')}</span>
          </span>
          <span class="next-go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 4h6v6M10 14 20 4M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></span>
        </a>
        <a class="feat next-item" href={pageUrl(lang, 'download')}>
          <svg class="next-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>
          <span class="next-text">
            <span class="next-title">{T('Download')}</span>
            <span class="next-line">{T('For macOS, Windows, Linux and Android 10 or newer. Free and open source.')}</span>
          </span>
          <span class="next-go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6"/></svg></span>
        </a>
      </div>
      <SupportStrip lang={lang} />
    </div>
  </section>
</Base>
