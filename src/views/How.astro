---
import Base from '../layouts/Base.astro';
import HowItWorks from '../components/HowItWorks.astro';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} page="how" title={t(lang, 'How the free indoor cycling app works · ORQWA')}
  description={t(lang, 'How the free indoor cycling app ORQWA works: rides stay on your device, no account needed, group rides peer-to-peer, and most of it works offline.')}>
  <HowItWorks lang={lang} />
  <div class="page-end"></div>
</Base>
