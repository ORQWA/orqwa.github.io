---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (en: string) => t(lang, en);
---
<Base lang={lang} page="credits" title={T('Credits and licences · ORQWA')}
  description={T('Credits for the map data, terrain and video shown on the ORQWA website, and the licences of ORQWA and this site.')}>
  <div class="wrap credits">
    <div class="sec-head">
      <h1>{T('Credits and Licences')}</h1>
      <p class="lede">{T('ORQWA builds on the work of others. This page credits what this website shows and uses.')}</p>
    </div>
    <section class="credit">
      <h2 class="h3">{T("Map and Terrain Data in the Screenshots")}</h2>
      <p set:html={T("Map tiles \u00a9 <a href=\"https://openfreemap.org\" target=\"_blank\" rel=\"noopener\">OpenFreeMap</a> \u00a9 <a href=\"https://openmaptiles.org\" target=\"_blank\" rel=\"noopener\">OpenMapTiles</a>, data \u00a9 <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap contributors</a>, available under the <a href=\"https://opendatacommons.org/licenses/odbl/\" target=\"_blank\" rel=\"noopener\">Open Database License (ODbL 1.0)</a>. Terrain by <a href=\"https://mapterhorn.com\" target=\"_blank\" rel=\"noopener\">Mapterhorn</a> (<a href=\"https://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noopener\">CC BY 4.0</a>) and <a href=\"https://registry.opendata.aws/terrain-tiles/\" target=\"_blank\" rel=\"noopener\">AWS Terrain Tiles</a>.")} />
    </section>
    <section class="credit">
      <h2 class="h3">{T("Video Course Screenshot")}</h2>
      <p set:html={T("The video course screenshot shows a frame of <a href=\"https://cycling.vangestel.online/indoor/videos/france/le-petit-menglonnais/\" target=\"_blank\" rel=\"noopener\">\u201cLe petit Menglonnais\u201d</a> by Fred Van Gestel, licensed under <a href=\"https://creativecommons.org/licenses/by-nc-sa/4.0/\" target=\"_blank\" rel=\"noopener\">CC BY-NC-SA 4.0</a>. The screenshot is under the same licence.")} />
    </section>
    <section class="credit">
      <h2 class="h3">{T("ORQWA")}</h2>
      <p set:html={T("ORQWA is free software under the <a href=\"https://github.com/ORQWA/ORQWA/blob/main/LICENSE\" target=\"_blank\" rel=\"noopener\">GPL-3.0</a>. Its settings list, under About, the licence of everything built into the app. <a href=\"https://github.com/ORQWA/ORQWA/blob/main/docs/CREDITS.md\" target=\"_blank\" rel=\"noopener\">All credits of the app</a>.")} />
    </section>
    <section class="credit">
      <h2 class="h3">{T("This Website")}</h2>
      <p set:html={T("Fonts: <a href=\"https://fonts.google.com/specimen/Instrument+Sans\" target=\"_blank\" rel=\"noopener\">Instrument Sans</a> and <a href=\"https://www.jetbrains.com/lp/mono/\" target=\"_blank\" rel=\"noopener\">JetBrains Mono</a> (<a href=\"https://openfontlicense.org\" target=\"_blank\" rel=\"noopener\">SIL Open Font License 1.1</a>). Built with <a href=\"https://astro.build\" target=\"_blank\" rel=\"noopener\">Astro</a> and <a href=\"https://lenis.darkroom.engineering\" target=\"_blank\" rel=\"noopener\">Lenis</a> (MIT) and <a href=\"https://gsap.com\" target=\"_blank\" rel=\"noopener\">GSAP</a> (<a href=\"https://gsap.com/standard-license\" target=\"_blank\" rel=\"noopener\">Standard \u201cno charge\u201d license</a>). The screenshots come from the ORQWA repository.")} />
    </section>
  </div>
</Base>
