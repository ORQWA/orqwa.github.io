---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (en: string) => t(lang, en);
---
<Base lang={lang} page="privacy" title={T('Privacy · ORQWA')}
  description={T('What data is processed when you visit the ORQWA website: no tracking, no analytics, no cookies.')}>
  <div class="wrap credits">
    <div class="sec-head">
      <h1>{T('Privacy')}</h1>
      <p class="lede">{T('This website has no tracking, no analytics, no cookies and no advertising. This page explains what data is still processed when you visit it.')}</p>
    </div>
    <section class="credit">
      <h2 class="h3">{T('Who Is Responsible')}</h2>
      <p set:html={T("This website is run by the <a href=\"https://github.com/ORQWA\" target=\"_blank\" rel=\"noopener\">ORQWA project on GitHub</a>, where its owners are listed. For questions about your data, <a href=\"https://github.com/ORQWA/ORQWA/issues\" target=\"_blank\" rel=\"noopener\">open an issue</a> in the ORQWA repository.")} />
    </section>
    <section class="credit">
      <h2 class="h3">{T('Hosting on GitHub Pages')}</h2>
      <p set:html={T("The website is hosted on GitHub Pages, a service of GitHub, Inc. in the USA. When you open a page, GitHub processes your IP address and technical details of the request, such as your browser and the time, to deliver the website and keep it secure. See <a href=\"https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement\" target=\"_blank\" rel=\"noopener\">GitHub's privacy statement</a>.")} />
    </section>
    <section class="credit">
      <h2 class="h3">{T('Requests to GitHub From Your Browser')}</h2>
      <p>{T("To show the latest release and the number of stars, your browser asks GitHub's API (api.github.com) directly, at most once an hour. GitHub receives your IP address with these requests.")}</p>
    </section>
    <section class="credit">
      <h2 class="h3">{T('Stored in Your Browser')}</h2>
      <p>{T('If you switch the language, the website remembers your choice in your browser. Until you close the tab, it also keeps the latest release, the number of stars and whether the intro video has played. None of this is sent anywhere, and you can delete it in your browser settings.')}</p>
    </section>
    <section class="credit">
      <h2 class="h3">{T('Fonts and Other Files')}</h2>
      <p>{T('Fonts, images, the video and scripts are served by this website itself, not loaded from other services.')}</p>
    </section>
    <section class="credit">
      <h2 class="h3">{T('Links to Other Websites')}</h2>
      <p>{T('Links to GitHub and other websites lead to services with their own privacy statements.')}</p>
    </section>
    <p class="updated">{T('Last updated: 14 November 2026')}</p>
  </div>
</Base>
