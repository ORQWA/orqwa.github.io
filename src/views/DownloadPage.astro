---
import Base from '../layouts/Base.astro';
import Download from '../components/Download.astro';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} page="download" title={t(lang, 'Download the free indoor cycling app · ORQWA')}
  description={t(lang, 'Download ORQWA, the free indoor cycling app for smart trainers, for macOS, Windows, Linux and Android tablets. Short install steps included.')}>
  <Download lang={lang} />
</Base>
