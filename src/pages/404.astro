---
import Base from '../layouts/Base.astro';
import { pageUrl } from '../i18n';
---
<Base lang="en" title="Page not found · ORQWA" description="This page does not exist, or it has moved." noindex>
  <div class="wrap not-found">
    <h1>Page not found</h1>
    <p class="lede">This page does not exist, or it has moved.</p>
    <p lang="de" class="lede">Diese Seite gibt es nicht, oder sie ist umgezogen.</p>
    <p><a class="btn btn-primary" href={pageUrl('en', 'home')}>Back to the start page</a></p>
  </div>
</Base>
