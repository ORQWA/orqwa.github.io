---
// A short, gentle ask that leads to the Support page, on the home and download pages.
import { t, pageUrl, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (en: string) => t(lang, en);
---
<div class="give">
  <span class="give-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.3C1 8.4 3 4.5 6.8 4.5c2.1 0 3.6 1.2 5.2 3 1.6-1.8 3.1-3 5.2-3 3.8 0 5.8 3.9 4.4 7.2C19.5 16.4 12 21 12 21z"/></svg></span>
  <div class="give-text">
    <h2 class="h3">{T('ORQWA is free, and stays free')}</h2>
    <p>{T('No subscription and no ads. If you enjoy your rides, you can help keep it going.')}</p>
  </div>
  <a class="btn" href={pageUrl(lang, 'support')}>{T('Support ORQWA')}</a>
</div>
