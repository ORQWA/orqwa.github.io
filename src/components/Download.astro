---
import { t, dateLocale, pageUrl, asset, type Lang } from '../i18n';
import SupportStrip from './SupportStrip.astro';
import { getRelease } from '../lib/release';
import { formatDate, mb, RELEASES_PAGE, SAMPLE_WORLD, type Slot } from '../lib/assets';
import firstCourse from '../lib/first-course.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = (en: string) => t(lang, en);
const rel = await getRelease();

// Release values are marked with data-rel / data-asset so src/scripts/release.ts can swap in a newer release.
const version = `<span data-rel="version">${rel.version}</span>`;
const date = `<span data-rel="date" data-iso="${rel.date}">${formatDate(rel.date, dateLocale(lang))}</span>`;
const heading = T('Download the App');
const released = T('Version 0.6.3, released 12 November 2026.')
  .replace('0.6.3', version).replace(/\d{1,2}\.? November 2026/, date);

const href = (slot: Slot) => rel.assets[slot]?.url ?? RELEASES_PAGE;
const name = (slot: Slot) => rel.assets[slot]?.name ?? '';
const size = (slot: Slot) => (rel.assets[slot] ? mb(rel.assets[slot]!.size) : '–');
const ext = { target: '_blank', rel: 'noopener' };

const platforms = [
  {
    os: 'macos', tab: 'macOS', button: 'Download for macOS', needs: 'M1<small>or newer</small>',
    steps: [
      'Unzip the download and open <b>ORQWA</b>.',
      'If macOS blocks it, close the warning with <b>Done</b>.',
      'Open <b>Privacy &amp; Security</b> in <b>System Settings</b>. Under Security, find the message about ORQWA and choose <b>Open Anyway</b>.',
      'Confirm with your password or Touch ID, then choose <b>Open Anyway</b> again.',
    ],
    note: 'This will happen again after every update. ORQWA runs on Macs with Apple silicon only.',
  },
  {
    os: 'windows', tab: 'Windows', button: 'Download for Windows', needs: '64-bit<small>Windows</small>',
    alt: { slot: 'windows-zip', label: 'Portable version, no install needed' },
    steps: [
      'Run the <b>.msi</b> installer, then open <b>ORQWA</b> from the Start menu.',
      'On “Windows protected your PC”, choose <b>More info</b>, then <b>Run anyway</b>.',
      'If Smart App Control blocks it without that option, ORQWA only runs with Smart App Control turned off under <b>App &amp; browser control</b> in <b>Windows Security</b>.',
    ],
    note: 'For the portable version, unzip it and keep all its files together in one folder.',
  },
  {
    os: 'linux', tab: 'Linux', button: 'Download for Linux', needs: 'Ubuntu<small>22.04+</small>',
    alt: { slot: 'linux-arm', label: 'Linux for ARM computers' },
    steps: [
      'Unpack the download.',
      'Open <b>ORQWA.x86_64</b> (or <b>ORQWA.arm64</b>). Keep all the unpacked files together.',
    ],
    note: 'Needs a recent Linux, such as Ubuntu 22.04 or Debian 12 or newer. The overlay needs an X11 desktop session.',
  },
  {
    os: 'android', tab: 'Android', button: 'Download for Android', needs: '10+<small>64-bit</small>',
    steps: [
      'Open the download on your Android device. Allow your browser or file manager to <b>install unknown apps</b>, then return and choose <b>Install</b>.',
      'If Play Protect warns, choose <b>More details</b>, then <b>Install anyway</b>.',
      'Allow <b>Nearby devices</b> to connect trainers and sensors. Before Android 12 this is called Location; ORQWA does not read your location.',
    ],
    note: "For Android 10 or newer. Uninstalling deletes ORQWA's data on the device, so export rides you want to keep first.",
  },
] as const;

const km = (firstCourse.length_m / 1000).toLocaleString(dateLocale(lang), { maximumFractionDigits: 1 });
const importSteps = [
  'In ORQWA, open <b>Courses</b> and press <b>Import</b>.',
  'Choose the downloaded file.',
  'Open <b>Twann – Chasseral</b> and press <b>Ride</b>.',
];

const firstRide = [
  ['Wake Your Trainer', 'Turn on Bluetooth and wake your trainer by pedalling.'],
  ['Connect It', 'Open <b>Devices</b>, press <b>Search</b> beside the trainer and wait for <b>Connected</b>.'],
  ['Set Up Your Profile', 'Open <b>Profile</b>, press the pencil and enter your weight, FTP (the power you can hold for about an hour) and maximum heart rate.'],
  ['Pick a Course', 'Open <b>Twann – Chasseral</b> under <b>Courses</b>. When it is ready, press <b>Ride</b>.'],
  ['Ride', 'Pedal to ride. Pause and ride settings are in the controls at the bottom left.'],
  ['Save Your Ride', 'Choose <b>Finish &amp; save</b>. Your ride appears under <b>History</b>.'],
];

---
<section class="dl" id="download" aria-labelledby="dl-h">
  <div class="wrap">
    <div class="sec-head">
      <h1 id="dl-h" set:html={heading} />
      <p class="lede" set:html={released} />
    </div>

    <div class="tabs" role="tablist" aria-label={T('Platform')} id="tabs" data-yours={T('yours')}>
      {platforms.map((p, i) => (
        <button role="tab" id={`tab-${p.os}`} aria-controls={`p-${p.os}`} aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? undefined : '-1'} data-os={p.os}>{T(p.tab)}</button>
      ))}
    </div>

    <div class="panels">
    {platforms.map((p, i) => (
      <div class="panel" role="tabpanel" id={`p-${p.os}`} aria-labelledby={`tab-${p.os}`} hidden={i !== 0}>
        <div class="card">
          <div class="hud">
            <span class="label">{T('Version')}</span><span class="label">{T('Size')}</span><span class="label">{T('Needs')}</span>
            <span class="v" set:html={version} />
            <span class="v"><span data-asset-size={p.os}>{size(p.os)}</span><small>MB</small></span>
            <span class="v" set:html={T(p.needs)} />
          </div>
          <a class="btn btn-primary" href={href(p.os)} data-asset={p.os} {...ext}>{T(p.button)}</a>
          <span class="file" data-asset-name={p.os}>{name(p.os)}</span>
          {'alt' in p && rel.assets[p.alt.slot] && (
            <div class="alt">
              <a href={href(p.alt.slot)} data-asset={p.alt.slot} {...ext}>{T(p.alt.label)}</a>
              <span class="mono"><span data-asset-name={p.alt.slot}>{name(p.alt.slot)}</span> · <span data-asset-size={p.alt.slot}>{size(p.alt.slot)}</span> MB</span>
            </div>
          )}
        </div>
        <div class="card">
          <h2 class="h3">{T('Install')}</h2>
          <ol class="install">
            {p.steps.map((s) => <li><span set:html={T(s)} /></li>)}
            <li><a href="#first-ride">{T('Start your first ride')}</a></li>
          </ol>
          <p class="note">{T(p.note)}</p>
        </div>
      </div>
    ))}
    </div>

    <div class="dl-more">
      <a class="ext" href="https://github.com/ORQWA/ORQWA/releases" {...ext}>{T('All releases')}</a>
      <a class="ext" href="https://github.com/ORQWA/ORQWA/actions/workflows/ci.yml?query=branch%3Amain" {...ext}>{T('Test versions')}</a>
      <a class="ext" href="https://github.com/ORQWA/ORQWA/wiki/Getting-started" {...ext}>{T('Full install guide')}</a>
      <a href={pageUrl(lang, 'alternatives')}>{T('Compare with other apps')}</a>
    </div>

    <SupportStrip lang={lang} />
  </div>
</section>

<section class="first-ride" id="first-ride" aria-labelledby="first-h">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="first-h">{T('Your First Ride')}</h2>
      <p class="try" set:html={T('Just want to try? Turn on <b>Fake trainer</b> under Devices and ride without any hardware.')} />
    </div>
    <div class="ride" id="ride">
      <div class="route" id="ride-route" aria-hidden="true" data-route={JSON.stringify(firstCourse.route)}>
        <span class="place">Twann <span class="m">{firstCourse.start_m} m</span></span>
        <span class="place">Chasseral <span class="m">{firstCourse.summit_m} m</span></span>
      </div>
      <div class="ride-text">
        <ol class="ride-steps" id="ride-steps">
          {firstRide.map(([title, text]) => (
            <li><h3 class="h3">{T(title)}</h3><p set:html={T(text)} />
              {title === 'Pick a Course' && <a class="ride-more" href="#sample-world">{T('Ride it as a detailed 3D world')}</a>}</li>
          ))}
        </ol>
        <p class="stuck">{T('Stuck?')} <a class="ext" href="https://github.com/ORQWA/ORQWA/wiki/Getting-started" {...ext}>{T('See the full guide')}</a>.</p>
      </div>
    </div>

    <div class="sample-world" id="sample-world">
      <div class="sec-head">
        <h3 class="sample-world-title">{T('Ride It in Full Detail')}</h3>
        <p>{T('The course from your first ride is also available as a detailed 3D world, with the vineyards, the Jura forest and the tower on the summit. Free to download and ride offline.')}</p>
      </div>
      <div class="panel">
        <div class="card">
          <img class="world-shot" src={asset('media/sample-world.webp')} alt={T('Riding past the Chasseral transmitter tower in the sample world')} width="1000" height="611" loading="lazy" decoding="async">
          <div class="hud">
            <span class="label">{T('Length')}</span><span class="label">{T('Summit')}</span><span class="label">{T('Size')}</span>
            <span class="v">{km}<small>km</small></span>
            <span class="v">{firstCourse.summit_m}<small>m</small></span>
            <span class="v">{mb(SAMPLE_WORLD.size)}<small>MB</small></span>
          </div>
          <a class="btn btn-primary" href={SAMPLE_WORLD.url}>{T('Download the sample world')}</a>
        </div>
        <div class="card">
          <h4 class="h3">{T('Import')}</h4>
          <ol class="install">
            {importSteps.map((s) => <li><span set:html={T(s)} /></li>)}
          </ol>
          <p class="note" set:html={T('This is a free demo. More are on the way, and <a href="/support">buying them supports ORQWA</a>.').replace('/support', pageUrl(lang, 'support'))} />
        </div>
      </div>
    </div>
  </div>
</section>
