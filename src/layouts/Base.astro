---
import '@fontsource-variable/instrument-sans/standard.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { t, pageUrl, asset, type Lang, type Page } from '../i18n';
import { getStars } from '../lib/repo';
import { formatStars } from '../lib/assets';

interface Props {
  lang: Lang;
  /** The page, for the language switch and the current link; none on the 404 page. */
  page?: Page;
  title: string;
  description: string;
  /** Keeps the page out of search results, e.g. the 404 page. */
  noindex?: boolean;
}
const { lang, page, title, description, noindex = false } = Astro.props;
const other: Lang = lang === 'en' ? 'de' : 'en';
const otherUrl = pageUrl(other, page ?? 'home');
const dePath = pageUrl('de', page ?? 'home');
const canonical = new URL(pageUrl(lang, page ?? 'home'), Astro.site);
const ogImage = new URL(asset('og.jpg'), Astro.site);
const here = (p: Page) => (p === page ? 'page' : undefined);
const ext = { target: '_blank', rel: 'noopener' };
const stars = await getStars();
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="google-site-verification" content="DgJRqd1TD7s0HClI5zarxX0tmu8nu50Q9bgVvs1-XJE">
  <meta name="theme-color" content="#070B12">
  <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml">
  {page && <link rel="canonical" href={canonical}>}
  {page && <link rel="alternate" hreflang="en" href={new URL(pageUrl('en', page), Astro.site)}>}
  {page && <link rel="alternate" hreflang="de" href={new URL(pageUrl('de', page), Astro.site)}>}
  {page && <link rel="alternate" hreflang="x-default" href={new URL(pageUrl('en', page), Astro.site)}>}
  {noindex && <meta name="robots" content="noindex">}
  <link rel="sitemap" href={asset('sitemap.xml')}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="ORQWA">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  {page && <meta property="og:url" content={canonical}>}
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="675">
  <meta property="og:image:alt" content={t(lang, 'ORQWA, a free indoor cycling app')}>
  <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_GB'}>
  <meta property="og:locale:alternate" content={lang === 'de' ? 'en_GB' : 'de_CH'}>
  <meta name="twitter:card" content="summary_large_image">
  <slot name="head" />
  {lang === 'en' && page && (
    <script is:inline define:vars={{ dePath }}>
      // German browsers get the German page, unless the rider chose English with the switch.
      try {
        var chosen = localStorage.getItem('orqwa-lang');
        if (chosen === 'de' || (!chosen && /^de\b/i.test(navigator.language || ''))) location.replace(dePath + location.hash);
      } catch (e) {}
    </script>
  )}
  <script defer src="https://cloud.umami.is/script.js" data-website-id="f2281d54-ed19-4c66-b3ca-24668e75d9b6"></script>
</head>
<body>
  <a class="skip" href="#main">{t(lang, 'Skip to content')}</a>
  <!-- Read out after every link that opens a new tab (src/scripts/links.ts). -->
  <span id="new-tab" hidden>{t(lang, 'opens in a new tab')}</span>

  <div class="bar" id="bar">
    <div class="wrap bar-in">
      <a class="brand" href={pageUrl(lang, 'home')} aria-label={t(lang, 'ORQWA home')}>
        <img src={asset('brand/mark.svg')} alt="" width="30" height="30">
        <img src={asset('brand/wordmark.svg')} alt="ORQWA" width="83" height="15">
      </a>
      <nav class="nav" aria-label={t(lang, 'Main')}>
        <a class="hide-s" href={page === 'home' ? '#features' : pageUrl(lang, 'home', '#features')}>{t(lang, 'Features')}</a>
        <a class="hide-s" href={pageUrl(lang, 'how')} aria-current={here('how')}>{t(lang, 'Under the Hood')}</a>
        <a class="ext hide-s" href="https://github.com/ORQWA/ORQWA/wiki" {...ext}>{t(lang, 'User Guide')}</a>
        <a class="hide-s support-link" href={pageUrl(lang, 'support')} aria-current={here('support')} aria-label={t(lang, 'Support ORQWA')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.3C1 8.4 3 4.5 6.8 4.5c2.1 0 3.6 1.2 5.2 3 1.6-1.8 3.1-3 5.2-3 3.8 0 5.8 3.9 4.4 7.2C19.5 16.4 12 21 12 21z"/></svg>
          <span class="hide-m">{t(lang, 'Support')}</span>
        </a>
        <a class="lang" href={otherUrl} hreflang={other} lang={other} data-lang={other}
          aria-label={other === 'de' ? 'Auf Deutsch wechseln' : 'Switch to English'}>{other.toUpperCase()}</a>
        <a class="star" href="https://github.com/ORQWA/ORQWA" {...ext} aria-label={t(lang, 'Star ORQWA on GitHub')}>
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          <span class="star-label">{t(lang, 'Star')}</span>
          <span class="star-count" data-stars hidden={stars === null}>{stars === null ? '' : formatStars(stars)}</span>
        </a>
        <a class="btn btn-primary" href={pageUrl(lang, 'download')} aria-current={here('download')}>{t(lang, 'Download')}</a>
      </nav>
      <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label={t(lang, 'Menu')}>
        <span></span><span></span><span></span>
      </button>
    </div>
    <!-- Narrow screens: the page links and the language, behind the menu button (src/scripts/bar.ts). -->
    <div class="menu" id="menu" hidden>
      <div class="wrap menu-in">
        <nav class="menu-nav" aria-label={t(lang, 'Menu')}>
          <a href={pageUrl(lang, 'home')} aria-current={here('home')}>{t(lang, 'Home')}</a>
          <a href={page === 'home' ? '#features' : pageUrl(lang, 'home', '#features')}>{t(lang, 'Features')}</a>
          <a href={pageUrl(lang, 'how')} aria-current={here('how')}>{t(lang, 'Under the Hood')}</a>
          <a href={pageUrl(lang, 'download')} aria-current={here('download')}>{t(lang, 'Download')}</a>
          <a class="ext" href="https://github.com/ORQWA/ORQWA/wiki" {...ext}>{t(lang, 'User Guide')}</a>
          <a href={pageUrl(lang, 'support')} aria-current={here('support')}>{t(lang, 'Support ORQWA')}</a>
        </nav>
        <div class="menu-foot">
          <div class="menu-lang" role="group" aria-label={t(lang, 'Language')}>
            {(['en', 'de'] as Lang[]).map((l) => (
              <a href={pageUrl(l, page ?? 'home')} hreflang={l} lang={l} data-lang={l} aria-current={l === lang ? 'true' : undefined}
                aria-label={l === 'en' ? 'English' : 'Deutsch'}>{l.toUpperCase()}</a>
            ))}
          </div>
          <nav class="menu-small" aria-label={t(lang, 'Project')}>
            <a href={pageUrl(lang, 'credits')} aria-current={here('credits')}>{t(lang, 'Credits and licences')}</a>
            <a href={pageUrl(lang, 'privacy')} aria-current={here('privacy')}>{t(lang, 'Privacy')}</a>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <slot name="hero" />
  <main id="main">
    <slot />
  </main>

  <footer>
    <div class="wrap">
      <div class="foot">
        <nav aria-label={t(lang, 'Project')}>
          <a href="https://github.com/ORQWA/ORQWA" {...ext}>{t(lang, 'Source code')}</a>
          <a href="https://github.com/ORQWA/ORQWA/wiki" {...ext}>{t(lang, 'User guide')}</a>
          <a href="https://github.com/ORQWA/ORQWA/releases" {...ext}>{t(lang, 'Releases')}</a>
        </nav>
        <nav aria-label={t(lang, 'Get involved')}>
          <a href={pageUrl(lang, 'support')} aria-current={here('support')}>{t(lang, 'Support ORQWA')}</a>
          <a href="https://github.com/ORQWA/ORQWA/issues" {...ext}>{t(lang, 'Report a bug or ask for a feature')}</a>
          <a href={pageUrl(lang, 'alternatives')} aria-current={here('alternatives')}>{t(lang, 'Compare with other apps')}</a>
        </nav>
        <nav aria-label={t(lang, 'About')}>
          <a href={pageUrl(lang, 'credits')} aria-current={here('credits')}>{t(lang, 'Credits and licences')}</a>
          <a href={pageUrl(lang, 'privacy')} aria-current={here('privacy')}>{t(lang, 'Privacy')}</a>
        </nav>
      </div>
      <p class="independent" set:html={t(lang, '<b>Written by AI, ridden at your own risk.</b> Every line of ORQWA is written by AI. There is no warranty, and we accept no liability for injury or for damage to your gear.')} />
      <p class="independent">{t(lang, 'ORQWA is an independent project. It is not affiliated with or endorsed by Zwift, Rouvy, MyWhoosh, TrainerRoad, Strava, intervals.icu, Garmin, Wahoo, Elite, Shimano or any other company or service. All names and trademarks belong to their owners.')}</p>
      <p class="copyright">© 2026 ORQWA · <a href="https://github.com/ORQWA/ORQWA/blob/main/LICENSE" {...ext}>{t(lang, 'Free software under the GNU GPL v3')}</a></p>
    </div>
  </footer>

  <script>
    import '../scripts/main';
  </script>
</body>
</html>
